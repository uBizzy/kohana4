# Apache 2.4: copy this file to public/.htaccess
#
# It needs mod_rewrite, and "AllowOverride All" for this directory in the
# configuration of the site. The parts in <IfModule> are used when their
# module is enabled and skipped when it is not.
#
# The security headers of the pages (X-Frame-Options, Content-Security-Policy,
# ...) are sent by the framework itself: see HTTP::$security_headers in
# application/bootstrap.php. This file only covers what never reaches PHP.

# No lists of files for a directory without an index, and no guessing of
# file names (MultiViews gets in the way of the rewrite rules)
Options -Indexes -MultiViews

# PHP runs through index.php only: a .php file that ends up in this directory
# by mistake, or by an attack on an upload, is not run
<FilesMatch "\.php$">
	Require all denied
</FilesMatch>
<Files "index.php">
	Require all granted
</Files>

<IfModule mod_rewrite.c>
	RewriteEngine On

	# The path of the site: / or /shop/
	RewriteBase /

	# Send everybody to HTTPS. Only for a site that is fully on HTTPS;
	# behind a proxy that ends HTTPS, test the X-Forwarded-Proto header instead
	#RewriteCond %{HTTPS} off
	#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

	# Hidden files and directories (.git, .env, .htaccess) are not served.
	# /.well-known/ stays open: certificates and apps look there
	RewriteRule (^|/)\.(?!well-known/) - [F]

	# Pass the Authorization header on to PHP (API tokens): PHP-FPM and CGI
	# do not get it otherwise
	RewriteCond %{HTTP:Authorization} .
	RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	# Real files and directories are served as they are
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d

	# Everything else goes to index.php
	RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
	# Files that Apache serves itself (CSS, JavaScript, images) do not get
	# the headers of the framework: a browser must not guess their type
	Header setifempty X-Content-Type-Options "nosniff"

	# CSS, JavaScript, images and fonts: the browser keeps them, and asks
	# each time whether they changed. Unchanged, the answer is a few bytes
	# ("304 Not Modified"); changed, the new file is sent at once
	<FilesMatch "\.(css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>

	# The date of a file says whether it changed. The ETag of Apache is
	# switched off: on a compressed file it never matches, and the file
	# would be sent again every time
	FileETag None

	# Faster still, for files whose name changes whenever their content does
	# (site.3f9a1c0e.css): they are kept for a year and never asked for again
	#<FilesMatch "\.[0-9a-f]{8,}\.(css|js|mjs|png|jpe?g|gif|webp|avif|svg|woff2?)$">
	#	Header set Cache-Control "public, max-age=31536000, immutable"
	#</FilesMatch>

	# Browsers must use HTTPS for the next year. Only for a site that is
	# fully on HTTPS, and only once you are sure: it cannot be taken back
	#Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<IfModule mod_deflate.c>
	# Text is sent compressed
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
